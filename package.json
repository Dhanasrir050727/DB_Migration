    "migration",
    "pg_dump",
    "pg_restore",
    "database",
    "testing"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.3.1",
    "pg": "^8.11.3"
  },
  "devDependencies": {},
  "engines": {
    "node": ">=18.0.0"
  }
}
